# Copy to .env and change EVERY value. Never commit .env.
#   Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-random-hex-characters-from-the-command-above
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
# letters and digits only (it is embedded in a URL)
DB_PASSWORD=replaceWithLettersAndDigits123

# Optional tuning
# RATE_RPS=50
# RATE_BURST=100
